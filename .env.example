NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Admin Panel (env-based auth)
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Demo mode: mock auth (any email/password logs in). Set to false for real Supabase auth.
NEXT_PUBLIC_DEMO_MODE=true

# Canonical public origin (drives password-reset links and payment callbacks)
NEXT_PUBLIC_SITE_URL=https://www.bookmyprofessional.com

# PayU payment gateway
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Leave these unset for production; override only for PayU's test environment.
#PAYU_PAYMENT_URL=https://test.payu.in/_payment
#PAYU_REFUND_URL=https://test.payu.in/merchant/postservice?form=2

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_NAME=Book my professional
BREVO_SENDER_EMAIL=noreply@bookmyprofessional.com
